---
import { getCollection } from "astro:content";

import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).filter(({ data }) => data.tier === "lab");
---

<BaseLayout title="Lab | Blake Schmitt" description="Technical experiments in mathematics, visualization, procedural systems, and interaction.">
  <section class="page-shell">
    <p class="eyebrow">Lab</p>
    <h1>Experiments that make curiosity executable.</h1>
    <ul class="project-list">
      {projects.map((project) => (
        <li><ProjectCard project={project} /></li>
      ))}
    </ul>
  </section>
</BaseLayout>
