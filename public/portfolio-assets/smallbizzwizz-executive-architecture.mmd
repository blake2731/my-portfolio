%%{init: {"theme": "base", "flowchart": {"htmlLabels": true, "curve": "basis"}, "themeVariables": {"primaryColor": "#ffffff", "primaryBorderColor": "#0f766e", "primaryTextColor": "#0b1220", "lineColor": "#2563eb", "secondaryColor": "#eef4f7", "tertiaryColor": "#f6f8fb", "fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"}}}%%
flowchart LR
    facility["Facility<br/><small>Customer business unit</small>"]
    upload["Upload<br/><small>Spreadsheet file, status, diagnostics</small>"]
    period["Reporting Period<br/><small>One period per upload</small>"]
    records["Financial Records<br/><small>Normalized row-level facts</small>"]
    insights["Insights<br/><small>Severity, trends, supporting metrics</small>"]
    narratives["Narratives<br/><small>Audience-specific AI summaries</small>"]

    facility -->|"owns"| upload
